{
  "name": "pi-customizations",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "description": "Independently toggleable personal Pi customizations.",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^20.14.0",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "extensions/*/index.ts"
    ]
  }
}
